{
  "name": "kiln",
  "version": "0.0.0",
  "description": "A static site generator that bakes Markdown into fast websites",
  "type": "module",
  "bin": {
    "kiln": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "node --test --test-concurrency=1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "nunjucks": "3.2.4"
  }
}
